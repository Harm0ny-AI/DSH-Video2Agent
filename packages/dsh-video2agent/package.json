{
  "name": "dsh-video2agent",
  "version": "0.3.8",
  "private": false,
  "description": "Bilibili/Douyin favorites gathering dust? Want your agent to gain video retrieval and understanding? Choose Video2Agent! One-click install gives your agent top-tier video understanding and turns online video into an information source. Whether you are researching social trends or working in media, any task that requires watching videos can now be handed to Video2Agent. Local-first; optional cloud ASR/OCR; optional Bilibili/Douyin login to unlock favorites/history and CC/AI subtitles.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harm0ny-AI/DSH-Video2Agent.git"
  },
  "homepage": "https://github.com/Harm0ny-AI/DSH-Video2Agent#readme",
  "bugs": {
    "url": "https://github.com/Harm0ny-AI/DSH-Video2Agent/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "files": [
    "index.js",
    "campaign.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "assets/"
  ],
  "keywords": ["dsh", "deepseek", "video", "bilibili", "douyin", "favorites", "video-qa", "video-search", "timestamp", "asr", "ocr", "local-first"],
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  }
}